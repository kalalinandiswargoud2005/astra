# ====================================================================
# ASTRA EDR - Production & Deployment Environment Variables Template
# ====================================================================

# Central PostgreSQL Database (e.g. Supabase / AWS RDS / Local Postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:6543/postgres?prepareThreshold=0&stringtype=unspecified
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password
HIKARI_MAX_POOL_SIZE=10

# Security - Cryptographically Secure JWT Secret Key (512-bit HS512 recommended)
JWT_SECRET=generate_a_random_secure_secret_for_production_use_1234567890

# AI Incident Intelligence
GEMINI_API_KEY=your_google_gemini_api_key

# Frontend URLs (for custom local or staging deployment)
VITE_API_URL=https://your-backend-url.onrender.com/api/v1
VITE_WS_URL=wss://your-backend-url.onrender.com/ws
